  "cards": [
    { "dot": "cyan", "title": "Startup and process lifetime", "items": ["run() dispatches commands; no command defaults to starting a shared terminal.", "Startup prepares a session directory and Unix socket, writes session metadata, forks the master, then attaches the original terminal.", "The master creates the PTY-backed shell. When the last attached client detaches after attachment, the loop signals the shell and exits."] },
    { "dot": "emerald", "title": "Socket message protocol", "items": ["Packets have a one-byte type, a four-byte big-endian payload length, then payload bytes.", "Message types cover input push, attach, detach, terminal resize, and stopping a whole session.", "The socket is local Unix-domain IPC; this implementation is not a remote network API."] },
    { "dot": "violet", "title": "Command tracking + persisted state", "items": ["The master polls the PTY foreground process group to infer current directory and whether a command is running.", "SessionState is serialized to state.json; session.json carries the session ID, paths, shell, and process metadata.", "output.log retains a bounded transcript; active-output.log captures output while a foreground command is running."] },
    { "dot": "amber", "title": "Output processing and agent reads", "items": ["Raw PTY output is broadcast to attached clients after terminal-title rewriting; the transcript path separately strips titles and filters alternate-screen output.", "render.rs interprets common terminal control sequences and reconstructs readable text for context/capture output.", "send-keys resolves a session, guards input while a process is running unless --force (with control-key/interrupt exceptions), sends encoded bytes, and can wait for output or completion."] },
    { "dot": "rose", "title": "Other code pieces", "items": ["setup.rs edits shell startup files for zsh/bash/fish, can install the embedded SKILL.md using npx skills, and caches npm update checks.", "style.rs gates ANSI colors on TTY detection and NO_COLOR; models.rs defines serialized record/cache/state shapes.", "Cargo.toml dependencies: clap (CLI), inquire (setup prompt), libc (PTY/process/terminal APIs), minreq (npm lookup), serde + serde_json (state)."] }
  ]
