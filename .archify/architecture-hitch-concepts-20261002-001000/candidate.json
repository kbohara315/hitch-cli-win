  "cards": [
    { "dot": "cyan", "title": "Terminal virtualization", "items": ["A pseudo-terminal (PTY) makes the child shell behave as if it were attached to a real terminal.", "Hitch can mediate input, output, window-size changes, and detach without replacing the user's shell experience."] },
    { "dot": "emerald", "title": "Local client–server + event loop", "items": ["The long-lived session master is the local server; CLI operations connect through a Unix-domain socket.", "A select-based loop watches the listener, PTY, and connected clients, so one coordinator handles concurrent readiness events."] },
    { "dot": "violet", "title": "Observability through a data pipeline", "items": ["PTY bytes are transformed for display and separately filtered before they are logged.", "File-backed session metadata and bounded transcripts let short-lived agent commands inspect a live session without owning its process."] },
    { "dot": "amber", "title": "Design trade-offs to notice", "items": ["Local-only IPC and files keep the core service lightweight; this design is aimed at one host, not remote multi-user access.", "The control plane (CLI / socket messages) is distinct from the data plane (interactive PTY bytes).", "A single master centralizes lifecycle and state, while output compaction bounds disk usage; process failure recovery is not depicted as durable service supervision."] }
